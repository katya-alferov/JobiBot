# CareerPilot Israel settings. Copy to .env and edit. Placeholder values only; never commit .env.

# Absolute zero-cost constraint. The app refuses to start if this is not true.
ZERO_COST_MODE=true

# Dry run: discover, score, prepare and simulate only. Never submits a real application.
DRY_RUN=true

# Global kill switch. true = real submissions are disabled no matter what else is set.
SUBMISSIONS_KILL_SWITCH=true

# Local storage
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/careerpilot.db
TIMEZONE=Asia/Jerusalem

# Limits
MAX_DAILY_APPLICATIONS=5

# Optional local model. Allowed values: none, ollama (local, free). Paid providers are rejected.
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434

# Comma-separated domains reviewed and approved for automated submission. Empty = none.
APPROVED_SUBMISSION_DOMAINS=

# Create a PDF next to each tailored DOCX (needs LibreOffice installed; free)
GENERATE_PDF=true
